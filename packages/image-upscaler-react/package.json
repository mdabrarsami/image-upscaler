{
  "name": "@mdabrarsami/image-upscaler-react",
  "version": "0.1.0",
  "description": "React bindings for @mdabrarsami/image-upscaler. A thin hook over the framework-agnostic core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@mdabrarsami/image-upscaler": "^0.1.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": { "access": "public" }
}
